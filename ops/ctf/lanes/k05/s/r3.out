{
  "name": "@keplerops/fieldlink-connector",
  "version": "7.4.3-cinder.rset1",
  "description": "FieldLink field-device diagnostic summary connector",
  "license": "UNLICENSED",
  "main": "index.js",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "limits.json",
    "README.md"
  ],
  "fieldkest": {
