{"_attachments":{},"_id":"@keplerops/fieldlink-connector","_rev":"22-f28b25f4f521b26f","channels":{"arwc-stable":{"rollback_candidates":["7.4.2"],"rollback_slot":"7.4.2"}},"compatible_interfaces":["fieldkest.connector/v2","fieldkest.connector/v3"],"dist-tags":{"latest":"7.4.2","legacy":"6.9.8","next":"7.4.3-cinder.rset1"},"interface":"fieldkest.connector/v3","name":"@keplerops/fieldlink-connector","pending_release":"7.4.3-cinder.rset1","readme":"# FieldLink connector 7.4.2\n\nThe connector summarizes callback observations for a named customer asset.\nIt exports `consume(request)` and accepts `fieldkest.connector/v3` requests.\nProvide `tenant_id`, `asset_id`, and an optional `measurements` object with\n`callback_latency_ms` and `sample_count`.\n\nThe result retains the tenant and asset, states the connector version, and\ncompares the observed latency and sample count with `limits.json`.\nMissing measurements are reported as unknown values rather than invented\nsamples. Invalid units or negative measurements are rejected.\n\n","time":{"6.9.8":"2026-11-19T07:07:37.113Z","7.4.0":"2026-11-19T07:07:38.278Z","7.4.1":"2026-11-19T07:07:39.390Z","7.4.2":"2026-11-19T13:49:20.259Z","7.4.3-cinder.rset1":"2026-11-19T07:07:35.928Z","created":"2026-11-19T07:07:35.928Z","modified":"2026-11-19T13:49:20.259Z"},"users":{},"versions":{"6.9.8":{"_id":"@keplerops/fieldlink-connector@6.9.8","_nodeVersion":"22.19.0","_npmVersion":"10.9.3","contributors":[],"deprecated":"The legacy v2 interface is retained for maintained installations. Maintenance record MTN-6.9.8. FLAG{870a03c573511895}","description":"FieldLink field-device diagnostic summary connector","dist":{"integrity":"sha512-+KvDkhs7BtY6cXemSNVtHJfCNTXuxEsvNYJahQ1jlIx3/xxh1fxc+5FoaiIcmKPF71qBuCv5R1Yy4CIJQhJu1w==","shasum":"ec39679f96ff60633f5b1fca2374e8076fd62f05","tarball":"https://packages.keplerops.test/@keplerops/fieldlink-connector/-/fieldlink-connector-6.9.8.tgz"},"engines":{"node":">=22"},"fieldkest":{"interface":"fieldkest.c