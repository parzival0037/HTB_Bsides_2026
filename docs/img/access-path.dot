digraph access {
  graph [rankdir=LR, fontname="DejaVu Sans", fontsize=12, nodesep=0.30, ranksep=0.55, bgcolor="white", pad=0.25, splines=ortho];
  node  [shape=box, style="rounded,filled", fontname="DejaVu Sans", fontsize=10, color="#54606e", fillcolor="#f6f8fb", penwidth=1.3, margin="0.16,0.09"];
  edge  [fontname="DejaVu Sans", fontsize=9, color="#54606e", arrowsize=0.7];

  a [label="Event plane\nbsides.keplerops.com\nwss /ws/terminal/{id}", fillcolor="#e6edfb"];
  b [label="kali  10.77.40.10\nuser cinder · sudo\nbox.py drives the pty", fillcolor="#dff3e4"];
  c [label="rowan-dev\n10.50.13.180 :2222\nssh key keplerops-foothold", fillcolor="#fdeacd"];
  d [label="SOCKS5 relay\n127.0.0.1:13389\nonly PermitOpen port", shape=ellipse, fillcolor="#fff2cc"];
  e [label="10.77.50.11 / 10.77.51.0-24\nstaff · gitea · jenkins\nreview · delivery · registry", fillcolor="#e6edfb"];
  f [label="connector.arwc.test  10.77.60.20\n403 channel_identity_denied\nfor every staff credential", fillcolor="#fbe3e3"];

  a -> b [label="  JSON input frames"];
  b -> c [label="  ssh"];
  c -> d [label="  runs", style=dashed, arrowhead=none];
  b -> d [label="  ssh -L 1080"];
  d -> e [label="  socks5h"];
  d -> f [label="  denied", color="#b03a3a", penwidth=1.8];
}
